  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "fflate": "^0.8.3",
    "maplibre-gl": "6.16.0",
    "polygon-clipping": "^0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/build-local-map.mjs",
    "build:map": "node scripts/build-local-map.mjs",
    "start": "node scripts/start-dev.mjs",
    "android": "node scripts/start-dev.mjs --android",
    "ios": "node scripts/start-dev.mjs --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
