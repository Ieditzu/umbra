# Copy to .env.public. Use random URL-safe credentials; do not commit secrets.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
UMBRA_WORKER_TOKEN=replace-with-at-least-32-random-characters
UMBRA_ENV=development
UMBRA_PUBLIC_URL=http://localhost:8000
UMBRA_BIND_ADDRESS=127.0.0.1
UMBRA_PORT=8000
UMBRA_TRUSTED_PROXY_CIDRS=

# Production requires HTTPS and SMTP with STARTTLS. Leave blank for local email links in logs.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# All three must be supplied before purchases are enabled.
# Price must be an active, one-time EUR 10.00 price for 100 credits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
