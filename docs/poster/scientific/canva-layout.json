  "texts": [
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBsqbv2xpkrytRzf",
      "text": "RoSEF 2026  /  TEHNOLOGIA INFORMAȚIEI ȘI COMUNICAȚIILOR",
      "left": 90,
      "top": 36,
      "width": 776,
      "height": 45.9675000000002,
      "font_size": 25,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LB8RJsqgrBwsMLy9",
      "text": "UMBRA",
      "left": 72,
      "top": 66,
      "width": 727,
      "height": 360.0787500000001,
      "font_size": 196,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LB4R0NVQdDS2c5gw",
      "text": "Trasee umbrite.\nÎnălțimi din umbre.",
      "left": 1417.5,
      "top": 105,
      "width": 458.046875,
      "height": 176.20874999999978,
      "font_size": 48,
      "bold": true,
      "color": "#b84419"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBz9fkpjGHt348Vl",
      "text": "Aplicație mobilă + cercetare\nConstanța",
      "left": 1417.5,
      "top": 276,
      "width": 347.90625,
      "height": 99.59625000000005,
      "font_size": 27,
      "bold": false,
      "color": "#625a6a"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBZg7b94xVC7qlht",
      "text": "Eduard-Mihai Perjoc · Eduard-Andrei Haivas · Cezar-Ștefan Manea",
      "left": 97.5,
      "top": 333,
      "width": 1009.8125,
      "height": 57.45937499999991,
      "font_size": 29,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBqYGFh9rrxrMvXH",
      "text": "Clasa a X-a · Constanța     |     Coordonator: prof. Ramona Rădulescu",
      "left": 97.5,
      "top": 384,
      "width": 798.5,
      "height": 45.9675000000002,
      "font_size": 25,
      "bold": false,
      "color": "#625a6a"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBYjpPNtP757CsJL",
      "text": "01  CE FACE APLICAȚIA UMBRA",
      "left": 108,
      "top": 464.25,
      "width": 436.796875,
      "height": 53.628749999999854,
      "font_size": 29,
      "bold": true,
      "color": "#ffffff"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LB4rPsWp92wYLZ93",
      "text": "Pe unde mergi cu mai puțin soare?",
      "left": 97.5,
      "top": 535.5,
      "width": 606.9375,
      "height": 65.12062500000002,
      "font_size": 35,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LB7BW26Gy5Ng3l38",
      "text": "Alegi plecarea, destinația, ora și ocolul\nmaxim acceptat.",
      "left": 97.5,
      "top": 645,
      "width": 482.90625,
      "height": 99.59625000000005,
      "font_size": 27,
      "bold": false,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBBdR2CFrTCbbcRF",
      "text": "Serverul modelează Soarele și umbrele și\ncompară traseele. Telefonul afișează harta\nși ghidarea GPS.",
      "left": 97.5,
      "top": 744,
      "width": 533.015625,
      "height": 149.39437499999985,
      "font_size": 27,
      "bold": false,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBmV6V576lQKvgqm",
      "text": "«Măsoară clădirea»: GPS, ruletă/laser sau\nfotografie din dronă → înălțime și\nincertitudine.",
      "left": 97.5,
      "top": 865.5,
      "width": 517,
      "height": 137.90250000000015,
      "font_size": 25,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBzxw0X9KvTHZfqC",
      "text": "Înălțimi confirmate → umbre și trasee.\nSalvare locală; partajare opțională.",
      "left": 97.5,
      "top": 985.5,
      "width": 427.03125,
      "height": 88.10437499999989,
      "font_size": 24,
      "bold": false,
      "color": "#b84419"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBbpmX2h9WbQb4PJ",
      "text": "02  PRINCIPIU ȘI METODĂ",
      "left": 108,
      "top": 1074.75,
      "width": 369.84375,
      "height": 53.628749999999854,
      "font_size": 29,
      "bold": true,
      "color": "#ffffff"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBXx30cSM3YpPm7j",
      "text": "h = L · tan(e)",
      "left": 108,
      "top": 1482,
      "width": 319,
      "height": 95.765625,
      "font_size": 52,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LB6DJ6HgfzKl3pBQ",
      "text": "h: înălțime · L: umbră pe sol · e: elevația Soarelui",
      "left": 108,
      "top": 1564.5,
      "width": 534.546875,
      "height": 44.052187499999945,
      "font_size": 24,
      "bold": false,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBJGMBtdKBrT893C",
      "text": "03  DATE ȘI REZULTATE",
      "left": 880.5,
      "top": 464.25,
      "width": 319.703125,
      "height": 53.628749999999854,
      "font_size": 29,
      "bold": true,
      "color": "#ffffff"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBsyvyMbWn3fp2Md",
      "text": "Fig. 1  Datele de înălțime lipsesc pentru 87,8% din clădiri",
      "left": 870,
      "top": 535.5,
      "width": 934,
      "height": 61.289999999999964,
      "font_size": 33,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBVqHT61b1tFSBVg",
      "text": "271 înălțimi OSM  ·  5.913 doar etaje  ·  85 alte cazuri",
      "left": 892.5,
      "top": 780,
      "width": 654,
      "height": 49.7981249999998,
      "font_size": 27,
      "bold": false,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBl7wprzGbQzvK5F",
      "text": "Instantaneu OSM: 51.428 clădiri; GBA asociat la 40.658 (79,1%).",
      "left": 892.5,
      "top": 841.5,
      "width": 791,
      "height": 49.7981249999998,
      "font_size": 27,
      "bold": false,
      "color": "#625a6a"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBHkH9C7KDBmyWXK",
      "text": "Fig. 2  Înălțimea GBA implicită pe etaj scade la blocurile înalte",
      "left": 870,
      "top": 938.9999999999995,
      "width": 1024,
      "height": 61.289999999999964,
      "font_size": 30,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBBD1jfNxW2TKVZd",
      "text": "Banda 2,5–3,5 m/etaj este o ipoteză orientativă, nu o referință măsurată.",
      "left": 892.5,
      "top": 1486.4999999999995,
      "width": 891.703125,
      "height": 47.8828125,
      "font_size": 26,
      "bold": false,
      "color": "#625a6a"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LB5zf2sgGF6Wqnlt",
      "text": "n total = 4.925; graficul arată 4.907 clădiri cu 1–12 etaje.",
      "left": 892.5,
      "top": 1540.5,
      "width": 686.96875,
      "height": 47.8828125,
      "font_size": 26,
      "bold": false,
      "color": "#625a6a"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBQGbCClsFDJcx0b",
      "text": "04  MODELUL INCERTITUDINII",
      "left": 108,
      "top": 1661.25,
      "width": 433.703125,
      "height": 53.62875000000008,
      "font_size": 29,
      "bold": true,
      "color": "#ffffff"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBCbDwqzsrpfMcbz",
      "text": "05  FEZABILITATE GEOMETRICĂ",
      "left": 1247.9999999999998,
      "top": 1661.25,
      "width": 439.90625,
      "height": 53.62875000000008,
      "font_size": 29,
      "bold": true,
      "color": "#ffffff"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBq3897YZxR0y8XM",
      "text": "Fig. 3  Eroarea lungimii se amplifică la Soare înalt",
      "left": 97.5,
      "top": 1735.5000000000002,
      "width": 758.125,
      "height": 57.45937499999991,
      "font_size": 31,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBhpGxPTDR2zzNBr",
      "text": "Fig. 4  Blocurile înalte au mai multe obstacole",
      "left": 1237.5,
      "top": 1735.5000000000002,
      "width": 706,
      "height": 57.45937499999991,
      "font_size": 31,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBxbW77MfGLBnDHf",
      "text": "δh ≈ tan(e) · δL",
      "left": 117,
      "top": 2359.5,
      "width": 314,
      "height": 76.61249999999995,
      "font_size": 42,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBGcTddjDxXCWv85",
      "text": "Graficul izolează eroarea lungimii. Nu reprezintă măsurători de\nprecizie. Panta, penumbra și erorile de asociere nu sunt incluse.",
      "left": 117,
      "top": 2424,
      "width": 805.8125,
      "height": 99.59625000000005,
      "font_size": 27,
      "bold": false,
      "color": "#625a6a"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBThTKHZpRCCYDsY",
      "text": "Toamna: 85–90% total; 60–71% la ≥20 m.",
      "left": 1255.4999999999998,
      "top": 2359.5,
      "width": 703.515625,
      "height": 65.12062500000002,
      "font_size": 35,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBw70fbNQ3MbTF61",
      "text": "Limită superioară în model: ignoră arborii, mașinile și accesul\nfizic. Înălțimi folosite: 261 OSM, 5.905 din etaje, 32.747 GBA.",
      "left": 1255.4999999999998,
      "top": 2424,
      "width": 773.90625,
      "height": 99.59625000000005,
      "font_size": 27,
      "bold": false,
      "color": "#625a6a"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBCZ5G6scbFZ9XRj",
      "text": "06  COMPARAȚIA GBA CU OSM",
      "left": 108,
      "top": 2619.750000000001,
      "width": 432.921875,
      "height": 53.62874999999997,
      "font_size": 29,
      "bold": true,
      "color": "#ffffff"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBlNhjn2KQSPtpCK",
      "text": "07  CERCETAREA SUSȚINE APLICAȚIA",
      "left": 1247.9999999999998,
      "top": 2619.750000000001,
      "width": 516.90625,
      "height": 53.62874999999997,
      "font_size": 29,
      "bold": true,
      "color": "#ffffff"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBtpYXznlcMKPv6p",
      "text": "Tabelul 1  Diferențe GBA − înălțime etichetată OSM",
      "left": 97.5,
      "top": 2692.5,
      "width": 736.09375,
      "height": 53.62874999999997,
      "font_size": 29,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBlLj2rhLHWYxHD9",
      "text": "Referințe OSM, neverificate pe teren. Total n = 88; 5 cazuri ≥40 m\nsunt omise aici și includ etichete OSM suspecte.",
      "left": 117,
      "top": 3009,
      "width": 802.140625,
      "height": 95.765625,
      "font_size": 26,
      "bold": false,
      "color": "#625a6a"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBKKR8d5yWDs9m0M",
      "text": "Subset concordant cu etajele: n = 37; bias −5,0 m; MAE 6,1 m.\nAceste diferențe nu stabilesc precizia absolută a GBA.",
      "left": 117,
      "top": 3096,
      "width": 749.484375,
      "height": 95.765625,
      "font_size": 26,
      "bold": false,
      "color": "#625a6a"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LB2qkrMhNdSB10kt",
      "text": "Întrebarea științifică",
      "left": 1252.5,
      "top": 2692.5,
      "width": 300.84375,
      "height": 53.62874999999997,
      "font_size": 29,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LB0k4qR7BXbspPQy",
      "text": "Cât de precis putem estima înălțimea unei clădiri din umbră\nși cum alegem momentul măsurării?",
      "left": 1252.5,
      "top": 2742,
      "width": 868.84375,
      "height": 107.25749999999994,
      "font_size": 29,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBMhR6DV3hxZqZbS",
      "text": "De la măsurare la recomandare",
      "left": 1252.5,
      "top": 2892,
      "width": 450.6875,
      "height": 53.62874999999997,
      "font_size": 29,
      "bold": true,
      "color": "#b84419"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBJnjzffWJGN09mf",
      "text": "Lungimea umbrei + Soarele → înălțime estimată → verificări și\nconfirmare în aplicație → actualizarea modelului de umbrire și a\ntraseelor.",
      "left": 1252.5,
      "top": 2947.5,
      "width": 736.5,
      "height": 137.90250000000003,
      "font_size": 25,
      "bold": false,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBMCDnh5zMGPBnp2",
      "text": "Aplicație testată pe teren în Constanța. Umbra calculează\numbrele, compară traseele și integrează înălțimile confirmate de\nutilizatori.",
      "left": 1252.5,
      "top": 3081,
      "width": 808,
      "height": 137.90250000000003,
      "font_size": 25,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBzHfMvvgqMQz7TL",
      "text": "REZULTATE COMPUTAȚIONALE: ANALIZA DATELOR OSM / GBA\nȘI SIMULAREA UMBRELOR.",
      "left": 117,
      "top": 3239,
      "width": 1362.9375,
      "height": 57.45937500000002,
      "font_size": 24,
      "bold": true,
      "color": "#ffffff"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LB5lvm2TdKMjP9J9",
      "text": "Surse și reproducere",
      "left": 97.5,
      "top": 3336,
      "width": 267.453125,
      "height": 47.8828125,
      "font_size": 26,
      "bold": true,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBLGrPs96dG8h75p",
      "text": "[1] OpenStreetMap contributors, extras 25.10.2026, ODbL.  [2] Zhu et al., GlobalBuildingAtlas, ESSD 17, 6647–6668 (2025).",
      "left": 97.5,
      "top": 3380.9999999999995,
      "width": 1256.6875,
      "height": 40.221562500000005,
      "font_size": 16,
      "bold": false,
      "color": "#321b40"
    },
    {
      "element_id": "PBpRKb3ny0X1d0bl-LBV7bhFWJqrtGMWg",
      "text": "[3] NOAA/Meeus, geometrie solară.  [4] Reda & Andreas, Solar Energy 76, 577–589 (2004).  Cod: github.com/Ieditzu/umbra",
      "left": 97.5,
      "top": 3424.4999999999995,
      "width": 1256.03125,
      "height": 40.221562500000005,
      "font_size": 16,
      "bold": false,
